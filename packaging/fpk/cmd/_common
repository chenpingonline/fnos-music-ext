#!/usr/bin/env bash
set -euo pipefail
APPNAME=fnmusic-go
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_ROOT="$(cd "${SELF_DIR}/.." && pwd)"
if [[ -n "${TRIM_APPDEST:-}" && -f "${TRIM_APPDEST}/bin/linux-amd64/fnmusic-go" ]]; then
  PAYLOAD="${TRIM_APPDEST}"
else
  PAYLOAD="${APP_ROOT}/target"
fi
case "$(uname -m)" in
  x86_64) APP_ARCH=linux-amd64 ;;
  aarch64|arm64) APP_ARCH=linux-arm64 ;;
  *) echo "unsupported architecture $(uname -m)" >&2; exit 1 ;;
esac
BINARY="${PAYLOAD}/bin/${APP_ARCH}/fnmusic-go"
ADMIN_SOCK="${PAYLOAD}/fnmusic-go.sock"
UNIT="fnmusic-go.service"
SERVICE_FILE="/etc/systemd/system/${UNIT}"
service_state(){ systemctl is-active --quiet "${UNIT}"; }
