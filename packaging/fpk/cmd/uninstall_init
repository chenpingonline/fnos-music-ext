#!/usr/bin/env bash
set -Eeuo pipefail
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "${SELF_DIR}/_common"
require_own_unit
check_dropin
stop_service
if [[ -f "$SERVICE_FILE" ]]; then
  systemctl disable "$UNIT"
  rm -f "$SERVICE_FILE"
fi
rm -f "$DROPIN"
rmdir "${SERVICE_FILE}.d" 2>/dev/null || true
systemctl daemon-reload
# Credentials and configuration remain in fnOS-managed var/etc; no implicit wipe.
